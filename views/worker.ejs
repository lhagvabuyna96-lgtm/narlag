<%- include("partials/header") %>
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">Ажилчин<%= user.job ? " · " + user.job : "" %></p>
    <h1>Захиалгууд</h1>
    <p>Захиалгыг хянана. Ажил дууссаны дараа гүйцэтгэсэн болгоно.</p>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <% if (notice) { %><div class="form-ok"><%= notice %></div><% } %>
    <% if (error) { %><div class="form-error"><%= error %></div><% } %>
    <% if (!orders.length) { %>
      <p class="lede">Захиалга алга.</p>
    <% } else { %>
      <div class="order-list" data-map-key="<%= mapKey %>">
        <% orders.forEach(function (order) {
          var pill = "pill--new";
          if (order.status === "баталгаажсан") pill = "pill--ok";
          if (order.status === "дууссан" || order.status === "гүйцэтгэсэн") pill = "pill--done";
          if (order.status === "цуцалсан") pill = "pill--off";
        %>
          <article class="order-card">
            <div class="order-card__top">
              <div>
                <h2><%= order.id %></h2>
                <p class="muted"><%= when(order.created_at) %></p>
              </div>
              <span class="pill <%= pill %>"><%= order.status %></span>
            </div>
            <div class="order-grid">
              <div>
                <h3>Захиалагч</h3>
                <p><%= order.customer_name %><br><%= order.phone %></p>
              </div>
              <div>
                <h3>Газар</h3>
                <p><%= day(order.visit_date) %> · <%= order.time_window %><br><%= order.area %>, <%= order.place %></p>
                <% if (order.lat != null && order.lng != null) { %>
                  <div class="map-frame map-frame--small" data-map-view data-lat="<%= order.lat %>" data-lng="<%= order.lng %>"></div>
                  <p><a href="https://www.google.com/maps/dir/?api=1&destination=<%= order.lat %>,<%= order.lng %>" target="_blank" rel="noopener">Зам заах</a></p>
                <% } else { %>
                  <p class="muted">Энэ захиалгад pin алга.</p>
                <% } %>
              </div>
              <div>
                <h3>Ажил</h3>
                <p>
                  <% if (order.lawn_m2) { %>Зүлэг <%= order.lawn_m2 %> м²<br><% } %>
                  <% if (order.tree_small || order.tree_mid || order.tree_large) { %>
                    Мод <%= order.tree_small %>/<%= order.tree_mid %>/<%= order.tree_large %><br>
                  <% } %>
                  <% if (order.edge) { %>Ирмэг<br><% } %>
                  <% itemsOf(order).forEach(function (item) { %>
                    <%= item.mode === "rent" ? "Түрээс" : "Авах" %> · <%= item.name %> × <%= item.qty %><br>
                  <% }) %>
                  <strong><%= money(order.total) %></strong>
                </p>
              </div>
            </div>
            <% if (order.note) { %><p class="muted"><%= order.note %></p><% } %>
            <%- include("partials/measure", { order: order, action: "/ajil/zahialga/" + encodeURIComponent(order.id) + "/hemjilt" }) %>
            <% if (order.status !== "гүйцэтгэсэн" && order.status !== "цуцалсан") { %>
              <form method="post" action="/ajil/zahialga/<%= encodeURIComponent(order.id) %>/guitsesen">
                <button class="btn btn--sun" type="submit">Гүйцэтгэсэн</button>
              </form>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
<%- include("partials/footer") %>
